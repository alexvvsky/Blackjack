<Window x:Class="Blackjack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blackjack"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900"
        Background="#2F5544">
    <Window.Resources>
        <local:ImageConverter x:Key="ImageConverter" />
        <DataTemplate x:Key="CardTemplate">
            <StackPanel Orientation="Vertical">
                <Image Source="{Binding CardImage, Converter={StaticResource ImageConverter}}" MaxHeight="130"/>
                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" Margin="5"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Canvas>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Dealer's Hand" Foreground="White" FontSize="14" Canvas.Top="10" Canvas.Left="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Content="{Binding DealerHandTotal}" Foreground="White" Margin="40,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
            
            <ListBox x:Name="ListBoxDealerHand" ItemsSource="{Binding DealerHand}" ItemTemplate="{StaticResource CardTemplate}" Background="Transparent" Height="180" Width="600" Canvas.Top="10" Canvas.Left="10">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"></StackPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <StackPanel Orientation="Horizontal">
                <Label Content="Player's Hand" Foreground="White" FontSize="14" Canvas.Top="190" Canvas.Left="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Label Content="{Binding PlayerHandTotal}" Foreground="White" Margin="40,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </StackPanel>
            <ListBox x:Name="ListBoxPlayerHand" ItemsSource="{Binding PlayerHand}" ItemTemplate="{StaticResource CardTemplate}" Background="Transparent" Height="180" Width="600" Canvas.Top="190" Canvas.Left="10" HorizontalAlignment="Center" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"></StackPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
        <TextBlock Foreground="#E4E6D8"  Canvas.Bottom="40" Canvas.Left="10" Text="Click Hit to draw a card, or quietly consult the Deck Inspector."/>
        <StackPanel Canvas.Bottom="10" Canvas.Left="10" Orientation="Horizontal">
            <Button x:Name="ButtonNewRound" Content="New Round" Padding="10, 5" Click="ButtonNewRound_Click"/>
            <Button x:Name="ButtonHit" Content="Hit" Margin="10,0,0,0" Padding="10, 5" Click="ButtonHit_Click"/>
            <Button x:Name="ButtonOpenDeckInspector" Content="Open Deck Inspector" Margin="10,0,0,0" Padding="10, 5" Click="ButtonOpenDeckInspector_Click"/>
        </StackPanel>

    </Canvas>
</Window>
