<Window x:Class="Blackjack.DeckInspector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blackjack"
        mc:Ignorable="d"
        Title="DeckInspector" Height="500" Width="500">
    <Window.Resources>
        <local:ImageConverter x:Key="ImageConverter" />
    </Window.Resources>
    <Canvas>
        <Label Content="DECK INSPECTOR" Canvas.Top="10" Canvas.Left="10" FontSize="20" FontWeight="Bold"></Label>
        <Label Content="First row = next card dealt." Canvas.Top="40" Canvas.Left="10"/>
        <Label Content="{Binding Deck.Count}" Canvas.Top="60" Canvas.Left="10"/>
        <StackPanel Orientation="Horizontal" Canvas.Top="85" Canvas.Left="10">
            <ListBox SelectedIndex="0" x:Name="DeckInspectorListBox"  ItemsSource="{Binding Deck}" Width="270" Height="285" HorizontalAlignment="Left" VerticalAlignment="Top">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Vertical" Margin="10, 0, 0, 0" DataContext="{Binding SelectedItem, ElementName=DeckInspectorListBox}">
                <Label Content="Selected Card" FontSize="16" Canvas.Left="296" Canvas.Top="58" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Image Source="{Binding CardImage, Converter={StaticResource ImageConverter}}" HorizontalAlignment="Center" MaxHeight="285" MaxWidth="150"/>
                <Label Content="{Binding Name}" FontSize="14" Margin="0, 0, 0, 0" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Canvas.Top="390" Canvas.Left="10">
            <Button Content="Move Up" Padding="5" Margin="0, 0, 10, 0" Click="MoveUp_Click"/>
            <Button Content="Move Down" Padding="5" Click="MoveDown_Click"/>
        </StackPanel>

    </Canvas>
</Window>
